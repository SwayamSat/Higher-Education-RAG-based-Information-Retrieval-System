        offset: 25,
        delay: 20,
        once: true,
      });

           jQuery(document).ready(function ($) {

        var currentLanguage = $('#gtCurrentLanguage').val(); 

        if(currentLanguage != 'en')
        {
            $('.gtNewText').html("नया"); 
            $('.gtMoreLinkText').html("अधिक पढ़ें"); 
            $('.gtPublishedEnText').html("");
            $('.gtPublishedHiText').html("को प्रकाशित");

            $('#quicktabs-tab-bureaus-0').children("a").html("विनियमन");
            $('#quicktabs-tab-bureaus-1').children("a").html("प्रशिक्षण और सीखना");
            $('#quicktabs-tab-bureaus-2').children("a").html("नीति एवं शैक्षणिक योजना");
            $('#quicktabs-tab-bureaus-3').children("a").html("प्रशासन");
            $('#quicktabs-tab-bureaus-4').children("a").html("छात्रवृत्ति एवं अनुदान");

            $('ul.tbm-nav').children("li.level-1:nth-child(8)").children(".tbm-link-container").children("a").html("सांख्यिकी");

            $(".tbm-caption").html("");

                        
 
        }

          
      });
      
</script>


