      <div class="container-fluid innerHead">
        <div class="container">
          <div class="row">
          <div class="col-md-7"> 
		   <h2>University And Higher Education</h2>
		   </div>
		   <div class="col-md-5 imgHide"> 
		    <div id="node-186" class="abtMhrd 
 "> 
            </div>
