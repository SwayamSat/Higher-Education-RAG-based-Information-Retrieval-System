  <div class="content">
    <div class="field field-name-body field-type-text-with-summary field-label-hidden"><div class="field-items"><div class="field-item even"><h2 class="page-title">
	Schemes</h2>
<!--<h2 class="sub-head"><p>	Sub-Mission on Polytechnics under the Coordinated Action for Skill Development</h2>
